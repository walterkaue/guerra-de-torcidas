# Valores públicos do Supabase (podem ir no front-end e no repositório).
# Os do projeto ficam versionados em .env.production e .env.development; para apontar para outro projeto, use .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque aqui a secret key (sb_secret_...) nem a senha do banco.
# A secret key só existe como segredo das funções do Supabase. Não use as chaves antigas anon e service_role.

# Aviso de domingo (push): chave PÚBLICA do par VAPID (a privada só nos segredos das funções).
VITE_VAPID_PUBLIC_KEY=

# CAPTCHA (Cloudflare Turnstile) no login: chave PÚBLICA do site. Vazia = desligado.
# A chave secreta vai só no painel do Supabase (Auth → Attack Protection), nunca aqui.
VITE_TURNSTILE_SITE_KEY=
