# Valores públicos do Supabase (podem ir no front-end e no repositório).
# Os de produção ficam versionados em .env.production; para apontar para outro projeto, copie para .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NUNCA coloque aqui a secret key (sb_secret_...) nem a senha do banco.
# A secret key só existe como segredo das funções do Supabase. Não use as chaves antigas anon e service_role.
